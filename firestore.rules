rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ────────────────────────────────────────────────────────────────
    // A user document holds byodConfig.telegramSession, which is a FULL-ACCOUNT
    // Telegram credential. Owner-only, always.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // ── Files ────────────────────────────────────────────────────────────────
    match /files/{fileId} {

      // NO ANONYMOUS ACCESS. This is deliberate and it is a security fix.
      //
      // There used to be an `allow get` branch here for public share links,
      // gated on `isShared == true`. It could not be made safe, because
      // Firestore rules authorise whole documents — they cannot restrict which
      // FIELDS come back. So any visitor holding a share link received the
      // entire document, including:
      //   • shareSettings.streamToken   — a capability valid up to 7 days
      //   • shareSettings.passwordVerifier / passwordSalt
      // Reading the doc directly therefore yielded the stream token, and the
      // password gate in SharedFilePage (which ran client-side only) could be
      // skipped outright. Narrowing `read` to `get` fixed enumeration but never
      // fixed this.
      //
      // Public sharing no longer touches Firestore. A share link now carries a
      // self-contained AES-256-GCM capability blob, decrypted only by the API
      // (api/telegram/share-resolve.ts), which verifies the password
      // server-side before it will return anything streamable. No secret lives
      // in a client-readable document any more.
      //
      // Consequence to preserve: an unauthenticated read of /files/{id} MUST be
      // denied. That is Stage 1's gate artifact.
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;

      // Create: the caller must stamp the document with their own uid, and the
      // core fields must be well-formed so a client cannot write junk that
      // breaks listing for everyone.
      allow create: if request.auth != null
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 512
                    && request.resource.data.type in ['file', 'folder']
                    && request.resource.data.isDeleted == false;

      // Update / delete: owner only. The owner must also remain the owner —
      // without this an update could hand the document to another uid.
      allow update: if request.auth != null
                    && resource.data.userId == request.auth.uid
                    && request.resource.data.userId == request.auth.uid;

      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}

# HCloud Relay — Oracle Cloud configuration
#
# Copy to .env in this same directory and fill in, then run:
#   sudo ./bootstrap.sh
#
# This file contains SECRETS. It is gitignored. Keep permissions tight (600).

# ---- Host ----------------------------------------------------------------
# Hostname that points at this VM's public IP via a DNS A record.
# A real hostname is REQUIRED: Let's Encrypt does not issue certificates for
# bare IPs, and browsers will not stream media over untrusted TLS.
RELAY_HOST=relay.yourdomain.com

# Where Let's Encrypt sends certificate-expiry warnings.
ADMIN_EMAIL=you@example.com

# ---- Telegram ------------------------------------------------------------
# From https://my.telegram.org -> API development tools.
# Must be the SAME pair configured on Vercel, or stream tokens minted by Vercel
# will not decrypt here.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# ---- Firebase ------------------------------------------------------------
# Your Firebase project id. The relay verifies each ID token's `aud` against it,
# so a wrong value rejects every authenticated request.
FIREBASE_PROJECT_ID=

# ---- CORS ----------------------------------------------------------------
# Comma-separated browser origins allowed to call the relay. Include your Vercel
# production origin, plus localhost for development.
CORS_ORIGIN=https://hcloud-pi.vercel.app,http://localhost:5173

# ---- Stream tokens -------------------------------------------------------
# Key material for the AES-256-GCM stream tokens, shared with Vercel.
# Leave EMPTY to derive the key from TELEGRAM_API_HASH (the default on both
# sides). If you set it here you MUST set the identical value on Vercel, and
# vice versa — a mismatch breaks every share link and all BYOD playback.
# Generate one with:  openssl rand -hex 32
STREAM_TOKEN_SECRET=

# ---- Optional ------------------------------------------------------------
# Gates the /stats endpoint. Leave empty to keep /stats disabled entirely.
ADMIN_SECRET=

# Rate limiting. Defaults are generous because media players issue many Range
# requests per video. Raise only if you see spurious 429s.
RATE_LIMIT_MAX=600
RATE_LIMIT_WINDOW_MS=60000
MAX_CONCURRENT_STREAMS_PER_IP=8
